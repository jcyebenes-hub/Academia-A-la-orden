# GALÓN — Copia este fichero a .env y completa los valores
# ═══════════════════════════════════════════════════
PORT=8000
PUBLIC_URL=https://tudominio.es
ADMIN_TOKEN=cambia-esto-por-una-clave-larga

# ── PAGOS · Opción A: Stripe (tarjetas + Bizum vía link, suscripciones) ──
# 1. Crea cuenta en stripe.com, activa "live mode"
# 2. Crea 4 precios (14.99€/mes, 79€ pago único, 19.99€/mes, 149€ pago único)
# 3. Pega los price_xxx aquí y tu clave sk_live_...
STRIPE_SECRET_KEY=
PRICE_PRO_MONTHLY=
PRICE_PRO_SINGLE=
PRICE_CARRERA_MONTHLY=
PRICE_CARRERA_SINGLE=
STRIPE_COUPON_CABO10=
STRIPE_WEBHOOK_SECRET=

# ── PAGOS · Opción B: Redsys / TPV Virtual (Caixa, Santander, BBVA…) ──
REDSYS_MERCHANT_CODE=
REDSYS_TERMINAL=1
REDSYS_SECRET_KEY=
REDSYS_ENV=test

# ── EMAIL real (verificación, recibos) con Resend.com ──
RESEND_API_KEY=
MAIL_FROM=GALÓN <hola@galon.app>

# ── Contenido ──
# 1 = servir solo preguntas aprobadas por experto (revisar.html)
CONTENT_STRICT=0
# Forzar cookies Secure incluso si no detecta HTTPS (útil tras proxy)
FORCE_SECURE_COOKIES=0

# ── TELEGRAM · bot de comunidad + Alertas BOD + pregunta del día ──
# 1) @BotFather → /newbot → copia el token aquí
# 2) Crea tu canal(es) y añade el bot como administrador
TELEGRAM_BOT_TOKEN=
# Ko-fi → ko-fi.com → Settings → API/Webhooks → pega aquí el "Verification Token"
# (cuando alguien invita un café, su email queda como "apoyado" y no ve el aviso)
KOFI_VERIFICATION_TOKEN=
# Canal general (recibe todo lo que no tenga ruta específica)
TELEGRAM_CHANNEL=
# Opcional: 1 canal por curso (las alertas se enrutan por su etiqueta)
# TELEGRAM_ROUTES=Cabo=@galon_cabo;Cabo 1º=@galon_cabo1;Permanente=@galon_perm

# ── RENDER (deploy gratis) ──
# URL pública REAL cuando exista (fija sola los enlaces de bot y mensajes)
# PUBLIC_URL=https://galon.onrender.com
# Persistencia: el disco de Render es efímero → volcado en un repo PRIVADO
# 1) GitHub → Settings → Developer settings → Fine-grained tokens → token solo para ese repo (permiso Contents: R/W)
# 2) Crea un repo privado (p. ej. tuusuario/galon-datos)
# GITHUB_TOKEN=github_pat_xxx
# GITHUB_REPO=tuusuario/galon-datos
# GITHUB_BRANCH=main
