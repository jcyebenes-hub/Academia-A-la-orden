# A LA ORDEN · variables de entorno (en Render: Dashboard → tu servicio → Environment)
# OBLIGATORIAS para el bot:
TELEGRAM_BOT_TOKEN=pega_aqui_el_token_del_bot
TELEGRAM_CHANNEL=@tu_canal
TELEGRAM_ROUTES=canal
# Ko-fi (aviso de cafés):
KOFI_VERIFICATION_TOKEN=token_del_webhook_kofi
# Recomendadas en Render:
PUBLIC_URL=https://tu-servicio.onrender.com
ADMIN_TOKEN=una_clave_larga_para_/api/admin/stats
# Persistencia de datos en Render (el disco es efímero en el plan gratis):
# crea un PAT de GitHub y un repo privado "datos" → la app guarda users/duelos/triviales vía API
GITHUB_TOKEN=
GITHUB_REPO=jcyebenes-hub/datos-alaorden
# Pagos (dormidos de propósito):
STRIPE_SECRET_KEY=
